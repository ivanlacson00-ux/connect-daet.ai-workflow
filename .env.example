# Supabase Configuration
# Get the URL and publishable key from Supabase Dashboard → Project Settings → API.
# Use a server-only service_role/secret key for SUPABASE_SERVICE_ROLE_KEY;
# never use the public publishable key there or expose the server key to the browser.

NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=https://replace-with-your-app-domain
APP_BASE_URL=https://replace-with-your-app-domain
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SENDGRID_API_KEY=replace-with-sendgrid-api-key
SENDGRID_FROM_EMAIL=verified-sender@example.com
SENDGRID_WEBHOOK_PUBLIC_KEY=replace-with-sendgrid-event-webhook-public-key

# Note: Never commit your actual .env file to GitHub!
# Copy this file to .env and fill in your actual values